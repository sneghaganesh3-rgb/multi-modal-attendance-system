# Copy to backend/.env and edit. Never commit the real .env.
DATABASE_URL=sqlite:///./attendance.db

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (If empty, a random key is used per run and logins are invalidated on every restart.)
SECRET_KEY=

# Password for the first-run "admin" account (only read when the admin is first created).
# If empty, a random password is generated and printed once in the backend console.
ADMIN_PASSWORD=

# Comma-separated origins allowed by CORS; also the allowed WebAuthn origin.
CORS_ORIGINS=http://localhost:5173
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Biometric thresholds and fusion weights (weights should sum to 1.0)
FACE_THRESHOLD=0.50
PALM_THRESHOLD=0.70
FINGERPRINT_THRESHOLD=0.75
FUSION_THRESHOLD=0.60
FACE_WEIGHT=0.45
PALM_WEIGHT=0.20
FINGERPRINT_WEIGHT=0.35

# Optional notifications (email / SMS)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
